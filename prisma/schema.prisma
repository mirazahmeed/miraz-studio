datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id             String             @id @default(cuid())
  title          String
  slug           String             @unique
  subtitle       String?
  excerpt        String
  description    String
  year           String
  client         String
  type           String             // e.g., "DIGITAL PRODUCT", "WEB APPLICATION", "DESIGN SYSTEM"
  role           String             // e.g., "DESIGN / DEVELOPMENT / STRATEGY"
  duration       String?            // e.g., "3 MONTHS"
  status         String             @default("PUBLISHED") // "PUBLISHED", "DRAFT", "ARCHIVED"
  featured       Boolean            @default(false)
  sortOrder      Int                @default(0)
  heroImage      String
  category       String             @default("WEBSITES") // "WEBSITES", "WEB APPS", "SAAS", "UI/UX", "AUTOMATION", "EXPERIMENTS"
  technologies   String             // JSON string array e.g. '["NEXT.JS", "TYPESCRIPT", "SUPABASE"]'
  specifications String?            // JSON string for specs table
  challenge      String?
  approach       String?
  solution       String?
  process        String?
  results        String?
  learnings      String?
  liveUrl        String?
  githubUrl      String?
  figmaUrl       String?
  caseStudyUrl   String?
  appStoreUrl    String?
  playStoreUrl   String?
  productHuntUrl String?
  behanceUrl     String?
  dribbbleUrl    String?
  seoTitle       String?
  seoDescription String?
  gallery        ProjectGallery[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model ProjectGallery {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Service {
  id           String   @id @default(cuid())
  number       String   // "01", "02", etc.
  title        String
  description  String
  imageUrl     String?
  technologies String   // JSON string array e.g. '["NEXT.JS", "REACT"]'
  sortOrder    Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  role       String
  company    String
  quote      String
  avatarUrl  String?
  projectRef String?
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  projectType String?
  budget      String?
  timeline    String?
  message     String
  status      String   @default("new") // "new", "read", "replied", "archived"
  createdAt   DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
